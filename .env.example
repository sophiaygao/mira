# OpenAI (optional for local demo — fallback reflective engine works without it)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Image model for companion avatars (gpt-image-2 recommended)
OPENAI_IMAGE_MODEL=gpt-image-2
# Faster avatar generation (low | medium | high). low is much less likely to time out.
OPENAI_IMAGE_QUALITY=low

# Hume AI — Empathic Voice Interface (voice, expression, empathy)
# Get keys at https://platform.hume.ai → API keys
HUME_API_KEY=
HUME_SECRET_KEY=
# Optional: reuse an existing EVI config instead of auto-creating one
# HUME_CONFIG_ID=

# Supabase (optional locally — leave blank to use .data/store.json)
# Fill these only after creating a real Supabase project and running supabase/schema.sql
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
