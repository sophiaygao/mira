# OpenAI — required for live Mira replies (same quality as local Cursor).
# Without this, Vercel uses canned fallback text that feels different.
# Add the same keys in Vercel → Project → Settings → Environment Variables
# (Production + Preview), then Redeploy.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Image model for companion avatars (gpt-image-2 recommended)
OPENAI_IMAGE_MODEL=gpt-image-2
# Faster avatar generation (low | medium | high). low is much less likely to time out.
OPENAI_IMAGE_QUALITY=low

# Hume AI — Empathic Voice Interface (voice, expression, empathy)
# Get keys at https://platform.hume.ai → API keys
HUME_API_KEY=
HUME_SECRET_KEY=
# Optional: reuse an existing EVI config instead of auto-creating one
# HUME_CONFIG_ID=

# Supabase (optional locally — leave blank to use .data/store.json)
# REQUIRED on Vercel for avatar uploads (serverless disk is read-only).
# 1) Create a Supabase project
# 2) Run supabase/schema.sql (creates mira_* tables + mira-avatars storage bucket)
# 3) Add these in Vercel → Settings → Environment Variables, then Redeploy
NEXT_PUBLIC_SUPABASE_URL=
# Public key: anon (legacy) or sb_publishable_... (new)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server key: service_role (legacy) OR sb_secret_... (new) — same elevated access
SUPABASE_SERVICE_ROLE_KEY=
# Optional alias for the new secret key name
# SUPABASE_SECRET_KEY=
